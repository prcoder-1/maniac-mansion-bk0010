/* Общие абсолютные адреса базового ОЗУ (smk.h). Загрузчик 01000..02177 и эта
 * область не сохраняются при чтении файла; ядро и состояние — 02400..026377
 * (сохраняются в SWAP), рабочие буферы 026400..035377, стек Си 035400..037777. */
_far_stk0 = 02200;   /* нижняя граница дальнего стека */
_far_sp   = 02374;   /* указатель дальнего стека (растёт вниз от 02374) */
_cur_page = 02376;   /* код режима+страницы, подключённой сейчас (для возврата) */
_bounce   = 026400;  /* 256 байт: перенос страница -> страница */
_band     = 027000;  /* 2 Кбайт: полоса рендера 16 байт x 128 строк */
_band_mask = 033000; /* 1280 байт: полоса z-маски */
_stack_low = 035400; /* дно стека Си (вершина — 040000) */
