/* Общие абсолютные адреса базового ОЗУ (smk.h). Загрузчик 01000..02777 и
 * дальний стек 03000..03177 не сохраняются при чтении файла; ядро и состояние —
 * 03200..023777 (вместе с буферами ниже уходят в SWAP на время чтения), стек Си —
 * до 040000. Окно 040000..077777 — страница ОЗУ БК-0011М (экран; драйвер звука). */
_far_stk0 = 03000;   /* нижняя граница дальнего стека (отладка: кадр ловушки 4) */
_far_sp = 03174;   /* указатель дальнего стека (растёт вниз от 03174) */
_cur_page = 03176;   /* код режима+страницы, подключённой сейчас (для возврата) */
_bounce = 025000;  /* 256 байт: перенос страница -> страница */
_v2_pat = 025400;  /* 256 байт: [чётность строки][точка k][цвет EGA, шаг 32] -> биты БК */
_v2_dt = 026000;  /* 128 байт: dither_table декодера v2 / буфер полосы маски */
_v2_col = 026200;  /* 512 байт: 4 колонки цветов EGA собираемого байта БК */
_v2_strips = 027200; /* 480 байт: StripTable картинки — на полосу {смещение, серия, цвет} (120 полос) */
_v2_zstrips = 030140; /* 480 байт: StripTable маски — на полосу {смещение, серия|флаг, байт} */
_band = 031100;  /* 2 Кбайт: RLE кадра костюма */
_boxes = 035100;  /* 512 байт: боксы и матрица комнаты (room.c; у MM не больше 361) */
/* 036100..036173 свободно (трамплин тестов, tools/scene.py) */
_smk_cur = 036174;   /* тень режима СМК: код последней тройки в 0177130 (обработчик «СТОП», crt0.s) */
_smk_sig = 036176;   /* слово общей копии кода в 0160000 (main.c): раскладка СМК восстановлена */
_stack_low = 036200; /* дно стека Си (вершина — 040000) */
