/* Общие абсолютные адреса базового ОЗУ (smk.h). Загрузчик 01000..02777 и
 * дальний стек 03000..03177 не сохраняются при чтении файла; ядро и состояние —
 * 03200..023777 (вместе с буферами ниже уходят в SWAP на время чтения), стек Си —
 * до 040000. */
_far_stk0 = 03000;   /* нижняя граница дальнего стека (отладка: кадр ловушки 4) */
_far_sp   = 03174;   /* указатель дальнего стека (растёт вниз от 03174) */
_cur_page = 03176;   /* код режима+страницы, подключённой сейчас (для возврата) */
_bounce   = 024000;  /* 256 байт: перенос страница -> страница */
_v2_pat   = 024400;  /* 256 байт: [чётность строки][точка k][цвет EGA, шаг 32] -> биты БК */
_v2_dt    = 025000;  /* 128 байт: dither_table декодера v2 / буфер полосы маски */
_v2_col   = 025200;  /* 512 байт: 4 колонки цветов EGA собираемого байта БК */
_v2_strips = 026200; /* 480 байт: StripTable картинки — на полосу {смещение, серия, цвет} */
_v2_zstrips = 026740; /* 480 байт: StripTable маски — на полосу {смещение, серия|флаг, байт} */
_band     = 027500;  /* 2 Кбайт: полоса рендера 16 байт x 128 строк */
_sndst    = 023740;  /* 22 байта: тон (snd.s), пишут sound.c и main.c */
_map_now  = 023766;  /* код подключённой сейчас страницы (вкл. временные) */
_snd_seqv = 023770;  /* адрес snd_seq (main.c): секвенсор из snd_tick */
_snd_busy = 023772;  /* snd_seq работает: не входить повторно */
_snd_seqt = 023774;  /* отсчёт таймера последнего такта секвенсора */
_snd_active = 023776; /* байт: звук играет (sound.c) */
_stack_low = 036200; /* дно стека Си (вершина — 040000) */
