/ Режим СМК-512 для игры: All (020) — вся страница в 0100000..0177777; на БК-0011М
/ контроллер выдаёт M11 и ПЗУ БОС на 0140000..0157777 отключается (доработка Б6).
/ ОЗУ10 (0120) M11 не выдаёт — на настоящей 11М его ОЗУ спорит с ПЗУ БОС.
/ Сегменты в All: 0100000 -> 4 .. 0130000 -> 7, 0140000 -> 0 .. 0170000 -> 3; сегмент 3
/ виден ещё и на чтение в 0177000..0177737 поверх регистров — там нули (smk_twins).
SMK_MODE = 020
/ страница SWAP: копия базового ОЗУ на время чтения файла (0100000..0134577, loader.s)
/ и снимок данных ядра при первом пуске (SNAP, метка SNAPM) — для перезапуска по «СТОП»
SWAP      = 6
SNAP      = 0140000
SNAPM     = 0137776
SNAPMAGIC = 0123457
/ переключение СМК тройкой: строб 6, код, 0 — только MOV
.macro	SMKSET src
	mov	$6, @$0177130
	mov	\src, @$0177130
	mov	$0, @$0177130
.endm
/ коды страниц 0..15 в регистре 0177130 (с режимом)
.macro	PCODES
	.word	SMK_MODE+0, SMK_MODE+02000, SMK_MODE+04, SMK_MODE+02004
	.word	SMK_MODE+010, SMK_MODE+02010, SMK_MODE+014, SMK_MODE+02014
	.word	SMK_MODE+01, SMK_MODE+02001, SMK_MODE+05, SMK_MODE+02005
	.word	SMK_MODE+011, SMK_MODE+02011, SMK_MODE+015, SMK_MODE+02015
.endm
